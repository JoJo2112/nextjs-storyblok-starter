# Copy to .env and fill in. All values are per-space — switch spaces by
# switching these (or override inline: STORYBLOK_SPACE_ID=<id> npm run schema:push).

# Space ID (Storyblok > Settings > General), used by the CLI schema scripts.
STORYBLOK_SPACE_ID=

# Delivery API token (Settings > Access Tokens). Use a "preview" token so
# draft mode works. Server-only — never add a NEXT_PUBLIC_ prefix.
STORYBLOK_DELIVERY_API_TOKEN=
